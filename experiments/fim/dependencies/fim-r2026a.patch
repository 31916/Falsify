--- /dev/null
+++ b/fim_arrange_system.m
@@ -0,0 +1,18 @@
+function fim_arrange_system(system_name)
+%FIM_ARRANGE_SYSTEM Arrange a Simulink system across MATLAB releases.
+%
+% In MATLAB R2026a, arrangeSystem raises glee_util:messages:GenericError
+% when the current layout cannot be improved. Older FIM releases treated
+% the call as best-effort, so preserve that behavior while rethrowing real
+% layout failures.
+
+try
+    Simulink.BlockDiagram.arrangeSystem(system_name);
+catch exception
+    no_change = strcmp(exception.identifier, 'glee_util:messages:GenericError') ...
+        && contains(exception.message, 'Layout has not changed');
+    if ~no_change
+        rethrow(exception);
+    end
+end
+end
